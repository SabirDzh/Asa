# Neon pooled connection string. Never expose this to the browser.
DATABASE_URL=postgresql://...

# At least 32 random characters. Used to sign httpOnly admin sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Admin login credentials as a JSON object. Generate each hash with:
# npm run hash-password -- '...'
ADMIN_USERS_JSON={"admin":"scrypt$..."}

# Used to hash rate-limit identifiers before storage. At least 32 random characters.
RATE_LIMIT_SALT=replace-with-another-long-random-secret

# Optional controls.
REPORT_RETENTION_DAYS=30
MAX_REPORTS_PER_INSTALLATION_PER_HOUR=10
MAX_REPORTS_PER_IP_PER_HOUR=50
MAX_LOGIN_ATTEMPTS_PER_IP_15M=10
